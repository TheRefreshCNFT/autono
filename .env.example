# Autono environment configuration
# Copy to .env and fill in your values — .env is gitignored

# Blockfrost API (https://blockfrost.io)
BLOCKFROST_API_KEY=mainnet_your_key_here
BLOCKFROST_NETWORK=mainnet

# GitHub token for repo watching (optional, increases rate limit from 60 to 5000/hr)
GITHUB_TOKEN=ghp_your_token_here
