{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDirs": ["./src", "../../src"],
    "baseUrl": ".",
    "paths": {
      "@wallet-engine/*": ["../../src/*"],
      "@noble/ed25519": ["node_modules/@noble/ed25519"]
    },
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*", "../../src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "../../src/**/*.test.ts"]
}
