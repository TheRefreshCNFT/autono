# wAli Wallet Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Blockfrost API Configuration
# Get your API key at: https://blockfrost.io
BLOCKFROST_PROJECT_ID=your_project_id_here

# Network Configuration
# Options: mainnet, testnet
CARDANO_NETWORK=mainnet

# Optional: Bitcoin API Configuration (if using)
# BITCOIN_API_KEY=your_bitcoin_api_key

# Optional: Development Settings
# NODE_ENV=production
